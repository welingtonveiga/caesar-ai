# Copy to .env in this directory and fill in the real values. Never commit .env.
# Bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=0000000000:replace-with-your-bot-token
# Comma-separated numeric IDs, e.g. 123456789,987654321.
TELEGRAM_ALLOWED_USER_IDS=replace-with-your-telegram-user-id
# API key for the default Gemini model.
GOOGLE_API_KEY=replace-with-your-google-api-key
